        <!-- 0. HEADER TITLE -->
        <mxCell id="hdr_main" value="PETA ALUR ARSITEKTUR FILE CRUD PHP NATIVE (CATATAN KEUANGAN)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#1e3a8a;fontColor=#ffffff;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1">
